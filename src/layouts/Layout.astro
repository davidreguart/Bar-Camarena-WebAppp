---
import siteContent from "../data/siteContent.json";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Bar Restaurante Camarena en Ontinyent: esmorzars de toda la vida, menú diario, carnes, pescados y arroces. Raciones para llevar al mediodía.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const { footer, timetable } = siteContent;

const dayMap = {
  LUNES: "Monday",
  MARTES: "Tuesday",
  "MIÉRCOLES": "Wednesday",
  JUEVES: "Thursday",
  VIERNES: "Friday",
  "SÁBADO": "Saturday",
  DOMINGO: "Sunday",
};

const openingHours = timetable.ticket.schedule.flatMap(({ day, hours }) => {
  const match = hours.match(/(\d{2}:\d{2})\s*-\s*(\d{2}:\d{2})/);
  if (!match) return [];
  return [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: dayMap[day as keyof typeof dayMap],
      opens: match[1],
      closes: match[2],
    },
  ];
});

const restaurantId = new URL("/#restaurant", Astro.site).toString();
const imageUrl = new URL("/img/fachada.jpg", Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Restaurant",
      "@id": restaurantId,
      name: "Bar Restaurante Camarena",
      description,
      url: new URL("/", Astro.site).toString(),
      telephone: "+34" + footer.contact.phone.replace(/\s/g, ""),
      image: [imageUrl],
      servesCuisine: ["Española", "Mediterránea"],
      priceRange: "€",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Carrer del Músic Enric Casanova, 8",
        addressLocality: "Ontinyent",
        addressRegion: "Valencia",
        postalCode: "46870",
        addressCountry: "ES",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 38.8207913280161,
        longitude: -0.6023554341826595,
      },
      openingHoursSpecification: openingHours,
      hasMenu: new URL("/carta/", Astro.site).toString(),
      hasMap: footer.map.url,
      sameAs: [footer.social.facebook.url, footer.social.google.url],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).toString(),
      url: new URL("/", Astro.site).toString(),
      name: "Bar Restaurante Camarena",
      inLanguage: "es-ES",
      publisher: { "@id": restaurantId },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#fff0e9" />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Bar Restaurante Camarena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fachada del Bar Restaurante Camarena en Ontinyent" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <a
      href={`tel:+34${footer.contact.phone.replace(/\s/g, "")}`}
      class="md:hidden fixed bottom-4 right-4 z-40 flex items-center justify-center min-h-12 px-6 rounded-full bg-rojo text-white font-bold shadow-lg"
      aria-label={`Llamar al ${footer.contact.phone}`}
    >
      Llamar
    </a>
  </body>
</html>

<style is:global>
  html {
    background-color: #fff0e9;
    letter-spacing: -0.025rem;
    scroll-behavior: smooth;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>
